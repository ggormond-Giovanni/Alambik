; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Alambic"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/visual/icone_alambic_v2.png"

[autoload]

Jeu="*res://autoload/jeu.gd"
Sons="*res://autoload/sons.gd"
ReglagesJoueur="*res://autoload/reglages_joueur.gd"
Ecran="*res://autoload/ecran.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]

theme/custom_font="res://assets/fonts/DMSans-Variable.ttf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="heros"
2d_physics/layer_2="ennemis"
2d_physics/layer_3="murs"
2d_physics/layer_4="tirs_heros"
2d_physics/layer_5="tirs_ennemis"

[physics]

common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.075, 0.105, 0.19, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
